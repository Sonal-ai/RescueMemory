NODE_ID=survivor-a
NODE_ROLE=survivor
DATA_DIR=./data/survivor-a
MODEL_CACHE=./data/model_cache
MESH_SHARED_KEY=replace-with-a-long-random-key-shared-by-local-nodes
RESPONDER_SHARED_KEY=replace-with-a-separate-long-random-key
NODE_ADMIN_KEY=replace-with-a-private-node-admin-key
GUIDE_TRUST_KEY=replace-with-a-long-random-guide-authentication-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# CENTRAL_URL=http://127.0.0.1:8000
# Keep these in this same .env locally. On Render, use the existing service
# environment variables. The backend uses one local .env file.
QDRANT_URL=
QDRANT_API_KEY=
DISCOVERY_PORT=8888
ENABLE_DISCOVERY=true


# Optional responder signing settings; setup_responder_issuer fills these in .env.
# RESPONDER_ISSUER_KEY_PATH=
# RESPONDER_ENROLLMENT_SECRET=
